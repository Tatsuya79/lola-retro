uniform sampler2D Source;

// Source pixel at x position xs on the native line that starts at row y.
// An upscaled frame has k rows per native line; they are averaged.
vec3 srcPix(float xs, float y, float k)
{
    if (xs < 0.0 || xs >= LR_SourceSize.x) return vec3(0.0);
    float u = (floor(xs) + 0.5) * LR_SourceSize.z;
    vec3 c = vec3(0.0);
    for (float r = 0.0; r < k; r += 1.0)
        c += textureLod(Source, vec2(u, (y + r + 0.5) * LR_SourceSize.w), 0.0).rgb;
    return c / k;
}

// Luma and modulated chroma at sample position n (in samples).
// trap > 0: the encoder's luma trap takes that share of the luma near the colour
// subcarrier (about +-0.5 MHz) out before mixing, so fine stripes leak less into
// the colour (less rainbow). The band is narrow, so plain brightness is not touched.
vec2 enc(float n, float y, float fs, Timing T, float trap, float blend)
{
    float ppx = T.pclk / fs;                 // source pixels per sample
    float xs = (n + 0.5) * ppx;
    vec3 c = srcPix(xs, y, T.scale);
    float Y = dot(c, vec3(0.299, 0.587, 0.114));

    if (blend > 0.0)
    {
        // dither blend (S-Video): take the 1-pixel alternating part out of luma.
        // Works on console pixels, so an upscaled frame blends the same way.
        float sp = T.scale;
        float j0 = floor(xs / sp);
        float y0 = dot(srcPix((j0 + 0.5) * sp, y, T.scale), vec3(0.299, 0.587, 0.114));
        float a = 0.0;
        for (int k = -4; k <= 4; k++)
        {
            float yk = dot(srcPix((j0 + float(k) + 0.5) * sp, y, T.scale), vec3(0.299, 0.587, 0.114));
            a += DBW[abs(k)] * dbSign(k) * (yk - y0);
        }
        Y -= blend * a / DBN;
    }
    float ph = phaseAt(n / fs, y, T);

    // the encoder limits chroma to about 1.5 MHz before modulation
    float sigUs = 0.1325 / 1.5;
    vec2 uv = vec2(0.0);
    float ws = 0.0;
    for (int k = -8; k <= 8; k++)
    {
        float u = float(k) * 0.4;            // in sigmas, covers +-3.2
        float w = exp(-0.5 * u * u);
        vec3 cc = srcPix(xs + u * sigUs * T.pclk, y, T.scale);
        float yy = dot(cc, vec3(0.299, 0.587, 0.114));
        uv += w * vec2(0.492 * (cc.b - yy), 0.877 * (cc.r - yy));
        ws += w;
    }
    uv /= ws;

    if (trap > 0.0)
    {
        // demodulate the luma at the subcarrier over a long window (narrow band),
        // then put that band back at this sample and subtract it
        float sigT = 0.1325 / 0.5;
        float da = TAU * T.fsc * 0.25 * sigT;    // subcarrier phase step between taps
        vec2 rp = vec2(cos(da), sin(da));
        vec2 e = vec2(cos(ph - 12.0 * da), sin(ph - 12.0 * da));
        vec2 yb = vec2(0.0);
        float wt = 0.0;
        for (int k = -12; k <= 12; k++)
        {
            float u = float(k) * 0.25;           // in sigmas, covers +-3
            float w = exp(-0.5 * u * u);
            float yy = dot(srcPix(xs + u * sigT * T.pclk, y, T.scale), vec3(0.299, 0.587, 0.114));
            yb += w * yy * e.yx;
            wt += w;
            e = vec2(e.x * rp.x - e.y * rp.y, e.y * rp.x + e.x * rp.y);
        }
        Y -= trap * 2.0 * (yb.x * sin(ph) + yb.y * cos(ph)) / wt;
    }

    return vec2(Y, uv.x * sin(ph) + vSign(y, T) * uv.y * cos(ph));
}

void lr_main()
{
    Timing T = getTiming(LR_OriginalSize.xy, LR_FrameCount);
    float SW = LR_OutputSize.x;
    float fs = T.pclk * SW / LR_SourceSize.x;     // sample rate (MHz)
    float n = floor(vTexCoord.x * SW);
    float y = floor(vTexCoord.y * LR_SourceSize.y);
    float cable = LR_CABLE;

    // RGB: no encoding, the decoder reads the original frame.
    // Upscaled frame: only the first row of each native line carries the signal.
    if (cable > 2.5 || mod(y, T.scale) > 0.5)
    {
        FragColor = vec4(0.0);
        return;
    }

    float trap = cable < 1.5 ? LR_YTRAP : 0.0;   // S-Video keeps luma apart, no trap needed
    float blend = cable > 1.5 ? LR_DBLEND : 0.0; // composite and RF blend dither by themselves
    vec2 a = enc(n, y, fs, T, trap, blend);
    vec2 r;
    if (cable < 0.5)
    {
        // RF: composite plus an echo and snow
        float comp = a.x + a.y;
        vec2 g = enc(n - RF_ECHO_US * fs, y, fs, T, trap, 0.0);
        comp += RF_ECHO * (g.x + g.y);
        float seed = float(LR_FrameCount % 997u);
        comp += (hash13(vec3(n, y, seed)) - 0.5) * LR_NOISE;
        comp += (hash13(vec3(floor(n / 7.0), y, seed + 3.0)) - 0.5) * LR_NOISE * 0.8;
        comp += sin(nativeLine(y, T) * 0.045 + seed * 0.37) * LR_NOISE * 0.12;
        r = vec2(comp, 0.0);
    }
    else if (cable < 1.5)
    {
        r = vec2(a.x + a.y, 0.0);
    }
    else
    {
        r = a;   // S-Video: luma and chroma on separate wires
    }
    FragColor = vec4(r, 0.0, 1.0);
}

// The adjustable values go to the later passes: texel k of the first row, blue channel.
float lr_param(int k)
{
    float p[30] = float[30](LR_NORM, LR_DBLEND, LR_SAT, LR_BRIGHT, LR_CONTRAST, LR_STEADY, LR_GAMMA, LR_CONV, LR_MASK_TYPE, LR_MASK_STR, LR_WHITE, LR_PHOS, LR_CURV_X, LR_CURV_Y, LR_CORNER, LR_GLOW, LR_GLOW_SIZE, LR_VIGNETTE, LR_OVERSCAN, LR_AMBIENT, LR_MON_SIZE, LR_MON_PITCH, LR_MON_SPOT_LO, LR_MON_SPOT_HI, LR_MON_CORNER, LR_SCREEN_H, LR_SCREEN_UNIT, LR_BACKDROP, LR_ROOM, LR_SPILL);
    return p[k];
}

void main()
{
    lr_main();
    ivec2 q = ivec2(gl_FragCoord.xy);
    if (q.y == 0 && q.x < 30) FragColor.b = lr_param(q.x);
}
#endif
