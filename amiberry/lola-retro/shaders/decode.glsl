#version 330 core
// Lola Retro - decode pass for Amiberry (Commodore 1084S).
// Generated by tools/make_glsl.py from shaders/lola-retro/shaders/decode.slang. Do not edit.

#define LR_FIELDS
#define LR_NO_FEEDBACK
#define LR_FIT_43
#define LR_ROWS_UP

uniform vec2 TextureSize;       // Source: the previous pass (the frame for the first pass)
uniform vec2 OrigTextureSize;   // Original: the emulator's frame
uniform vec2 OutputSize;        // this pass
uniform int FrameCount;
#define LR_SourceSize vec4(TextureSize, 1.0 / TextureSize)
#define LR_OriginalSize vec4(OrigTextureSize, 1.0 / OrigTextureSize)
#define LR_OutputSize vec4(OutputSize, 1.0 / OutputSize)
#define LR_FrameCount uint(FrameCount)

// fixed by the preset
const float LR_CABLE = 3.0;
const float LR_COMB = 0.0;
const float LR_CONSOLE = 6.0;
const float LR_DEMOD = 0.0;
const float LR_MON_MM = 1.0;
const float LR_SHARP = 0.1;
const float LR_TINT = 0.0;

// adjustable values, read from the first pass's output in main()
uniform sampler2D LR_Signal;
float LR_NORM;
float LR_DBLEND;
float LR_SAT;
float LR_BRIGHT;
float LR_CONTRAST;
float LR_STEADY;
float LR_PHOS;
float LR_OVERSCAN;
float LR_MON_SIZE;
float LR_MON_CORNER;

// Lola Retro - pass 2: the TV's decoder.
// Luma: low-pass with peaking ("sharpness"), plus a trap that removes the
// chroma band (done by re-modulating the decoded chroma, as a real LC trap does
// spectrally), or a 2-line comb filter.
// Chroma: synchronous demodulation and a narrow low-pass (consumer sets: ~0.6 MHz).
// PAL: delay-line averaging with the previous line.
// Filters are Gaussians in time, so they do not depend on the sample rate.

// Lola Retro - shared parameters, uniforms and helpers for every pass.
//
// The chain simulates the whole analog path:
//   console encoder -> cable -> TV decoder -> electron beam -> phosphor mask -> glass.
// Console timing (pixel clock, subcarrier cycles per line) decides how composite
// artefacts look, so it is part of the model.

const float TAU = 6.28318530718;

// Dither blend (RGB and S-Video, off by default): composite blended 1-pixel dither
// patterns into new colours or transparency; on RGB they stay visible as stripes.
// The blend finds the part of the picture that alternates from one console pixel to
// the next (a Gaussian window of 1.25 pixels with alternating signs, a narrow notch at
// half the pixel clock) and takes it out. Flat areas, gradients and wider detail are
// left alone. Weights for offsets 0..4 and the normalisation 4 * (w1 + w3):
const float DBW[5] = float[5](1.0, 0.726149, 0.278037, 0.056135, 0.005976);
const float DBN = 3.129136;
float dbSign(int k) { return (abs(k) & 1) == 1 ? -1.0 : 1.0; }

// RF: the echo (multipath ghost) added by the antenna path
const float RF_ECHO = 0.12;      // strength
const float RF_ECHO_US = 0.8;    // delay in microseconds

float hash13(vec3 p3)
{
    p3 = fract(p3 * 0.1031);
    p3 += dot(p3, p3.zyx + 31.32);
    return fract((p3.x + p3.y) * p3.z);
}

// ---------------------------------------------------------------------------
// Console timing
// ---------------------------------------------------------------------------
// Console ids: 1 SNES/NES, 2 Mega Drive H40, 3 Mega Drive H32, 4 PlayStation,
// 5 PlayStation 2, 6 Amiga, 7 PC VGA, 8 Arcade 15 kHz, 9 Arcade 24 kHz.

float autoConsole(vec2 s)
{
    float w = s.x, h = s.y;
    bool mon15 = LR_MON_MM > 0.5;    // a 15 kHz monitor cannot show 31 kHz VGA
    if (!mon15 && ((w == 320.0 && h == 200.0) || (w == 640.0 && (h == 350.0 || h == 400.0)))) return 7.0;
    if (h == 256.0 || h == 512.0 || (w == 640.0 && h == 200.0)) return 6.0;
    if (mon15 && (h == 200.0 || h == 400.0) && (w == 320.0 || w == 640.0)) return 6.0;
    // PUAE's default frames: the whole overscan area, 360, 720 or 1440 wide (PAL 287 or 574 rows, NTSC 242 or 484)
    if ((w == 360.0 || w == 720.0 || w == 1440.0) && (h == 287.0 || h == 574.0 || h == 242.0 || h == 484.0)) return 6.0;
    if (h >= 336.0 && h <= 400.0 && w >= 400.0) return 9.0;
    if (h > 300.0) return 5.0;
    if (w > 420.0) return 4.0;
    if (w <= 300.0) return 1.0;
    if (h >= 232.0) return 4.0;
    return 2.0;
}

// a: pixel clock NTSC, pixel clock PAL (MHz), nominal width, scan mode (0 TV, 1 VGA, 2 fill)
// b: subcarrier phase step per line (NTSC, PAL), per field (NTSC, PAL)
// c: x = 1 when the PAL line count per field is odd (V-switch flips every field)
void consoleTable(float id, out vec4 a, out vec4 b, out float c)
{
    if (id < 1.5)      { a = vec4(5.369318, 5.320342, 256.0, 0.0); b = vec4(1.0 / 3.0, 1.0 / 6.0, 1.0 / 3.0, 0.0);  c = 0.0; }
    else if (id < 2.5) { a = vec4(6.711647, 6.650428, 320.0, 0.0); b = vec4(0.0, 0.0, 0.0, 0.0);                    c = 1.0; }
    else if (id < 3.5) { a = vec4(5.369318, 5.320342, 256.0, 0.0); b = vec4(0.0, 0.0, 0.0, 0.0);                    c = 1.0; }
    else if (id < 4.5) { a = vec4(6.711647, 6.652800, 320.0, 0.0); b = vec4(0.5, 0.75, 0.5, 0.5);                  c = 0.0; }
    else if (id < 5.5) { a = vec4(13.5, 13.5, 640.0, 0.0);        b = vec4(0.5, 0.75, 0.75, 0.875);                c = 0.0; }
    else if (id < 6.5) { a = vec4(7.15909, 7.09379, 320.0, 0.0);  b = vec4(0.5, 0.75, 0.75, 0.875);                c = 0.0; }
    else if (id < 7.5) { a = vec4(12.5875, 12.5875, 320.0, 1.0);  b = vec4(0.5, 0.75, 0.75, 0.875);                c = 0.0; }
    else if (id < 8.5) { a = vec4(6.711647, 6.711647, 320.0, 0.0); b = vec4(0.5, 0.75, 0.5, 0.5);                  c = 0.0; }
    else               { a = vec4(16.0, 16.0, 496.0, 2.0);        b = vec4(0.5, 0.75, 0.75, 0.875);                c = 0.0; }
}

// Internal resolution: an upscaled frame (more than 576 lines, or a console set by hand
// whose native mode is smaller) is read as k x k blocks of one native pixel.
// Returns k (1 for native frames).
float upscaleOf(vec2 orig)
{
    float id = LR_CONSOLE;
    bool tv = id < 5.5 || (id > 7.5 && id < 8.5);       // VGA, Amiga and 24 kHz modes are never scaled
    float base = (id > 4.5 && id < 5.5) ? 480.0 : 240.0; // PS2 by hand: 480i class, otherwise 240p class
    bool scaled = id < 0.5 ? orig.y > 576.0 : (tv && orig.y > base * 1.5);
    if (!scaled) return 1.0;
    for (float k = 2.0; k <= 16.0; k += 1.0)
    {
        float lines = orig.y / k;
        if (lines == floor(lines) && lines >= base * 0.83 && lines <= base * 1.21) return k;
    }
    return max(1.0, floor(orig.y / base + 0.5));
}

struct Timing
{
    float pclk;        // pixel clock for this source width (MHz)
    float fsc;         // colour subcarrier (MHz)
    float lineFrac;    // subcarrier phase advance per line (cycles)
    float fieldStep;   // phase advance per field (cycles)
    float framePhase;  // phase offset of the current field (cycles)
    float vsw;         // PAL V-switch offset for this field
    float pal;         // 1 = PAL
    float scan;        // 0 TV raster, 1 VGA line doubling, 2 fill (24 kHz arcade)
    float interlace;   // 1 = 480i/576i source
    float scale;       // internal resolution factor of the core (1 = native)
    float id;          // console timing id (see consoleTable)
    float hres;        // frame pixels per console pixel (Amiga: 1 lores, 2 hires, 4 superhires)
};

bool isAmiga(Timing t) { return t.id > 5.5 && t.id < 6.5; }

Timing getTiming(vec2 orig, uint frameCount)
{
    Timing t;
    t.scale = upscaleOf(orig);
    vec2 nat = orig / t.scale;                          // the console's native mode
    float id = LR_CONSOLE < 0.5 ? autoConsole(nat) : LR_CONSOLE;
    vec4 a; vec4 b; float c;
    consoleTable(id, a, b, c);
    t.id = id;
    if (id > 4.5 && id < 5.5 && nat.x > 700.0) a.z = 720.0;   // PS2 720-wide modes keep 13.5 MHz
    t.scan = a.w;
    t.interlace = (t.scan < 0.5 && nat.y > 300.0) ? 1.0 : 0.0;
    bool amiga = id > 5.5 && id < 6.5;
    if (LR_NORM > 1.5) t.pal = 1.0;
    else if (LR_NORM > 0.5) t.pal = 0.0;
    else
    {
        float lines = t.interlace > 0.5 ? nat.y * 0.5 : nat.y;
        // an Amiga NTSC frame with its overscan border has up to 243 lines, a PAL one 256 or more
        t.pal = (t.scan < 0.5 && lines > (amiga ? 249.5 : 240.5)) ? 1.0 : 0.0;
    }
    // full source width: a wider (upscaled) line still takes the same time
    float base = mix(a.x, a.y, t.pal);
    t.pclk = base * orig.x / a.z;
    // Amiga: the width tells lores, hires or superhires. Emulators often send the whole
    // overscan area (PUAE and Amiberry: 720 wide in hires), so a wider frame is a longer
    // line at the same pixel clock, not faster pixels.
    float cls = orig.x < 480.0 ? 1.0 : (orig.x < 960.0 ? 2.0 : 4.0);
    if (amiga) t.pclk = base * (320.0 * cls) / a.z;
    // SVGA modes run faster lines: VESA 75 Hz clocks (800x600 49.5 MHz, 1024x768 78.75 MHz)
    if (t.scan > 0.5 && t.scan < 1.5 && orig.x > 720.0) t.pclk = 78.75 * orig.x * orig.y / (1024.0 * 768.0);
    t.hres = amiga ? cls : orig.x / a.z;
    t.fsc = t.pal > 0.5 ? 4.433619 : 3.579545;
    t.lineFrac = mix(b.x, b.y, t.pal);
    t.fieldStep = mix(b.z, b.w, t.pal);
    // 24 is a multiple of every field cycle above (1, 2, 3, 4, 8), so the phase never drifts
    float fc = LR_STEADY > 0.5 ? 0.0 : float(frameCount % 24u);
    t.framePhase = fract(fc * t.fieldStep);
    t.vsw = mod(fc * c, 2.0);
    return t;
}

// Frame pixels and rows per console pixel and line, for effects sized on the glass (glow,
// misconvergence). Only the Amiga needs it: its emulators send hires frames (2 pixels per lores
// pixel) and draw every line twice or weave two fields. Other consoles keep (1, 1).
vec2 consoleUnit(Timing t) { return isAmiga(t) ? vec2(t.hres, t.interlace > 0.5 ? 2.0 : 1.0) : vec2(1.0); }

// y is a source row; rows of one upscaled block belong to the same native line
float nativeLine(float y, Timing t) { return floor(y / t.scale); }
float physLine(float y, Timing t) { float l = nativeLine(y, t); return t.interlace > 0.5 ? floor(l * 0.5) : l; }
bool oddField(float y, Timing t) { return t.interlace > 0.5 && mod(nativeLine(y, t), 2.0) > 0.5; }

// Subcarrier phase at time tUs (microseconds from the start of the active line) on line y
float phaseAt(float tUs, float y, Timing t)
{
    float fo = oddField(y, t) ? t.fieldStep : 0.0;
    return TAU * fract(fract(t.fsc * tUs) + fract(t.lineFrac * physLine(y, t)) + fo + t.framePhase);
}

// PAL alternates the sign of V on every line
float vSign(float y, Timing t)
{
    if (t.pal < 0.5) return 1.0;
    float pl = physLine(y, t) + t.vsw + (oddField(y, t) ? 1.0 : 0.0);
    return mod(pl, 2.0) < 0.5 ? 1.0 : -1.0;
}

// ---------------------------------------------------------------------------
// Monitor in millimetres: PC monitors (31 kHz modes) always, and 15 kHz monitors such as
// the Commodore 1084S when "15 kHz monitor in mm" is on. The tube is described like on its
// spec sheet (size, mask pitch, beam spot on dark and on white), so every video mode follows
// from the same tube: 320x200 doubled to 400 lines or 1024x768 on a PC monitor, PAL or NTSC
// on the 1084S (NTSC lines sit further apart, so they show more).
// Typical mid-90s 15-inch PC monitor: 13.8-14 inch viewable, 0.28 mm dot pitch, a spot of
// about 0.45 mm on white (sharp at 800x600, soft at 1024x768), dynamic focus keeping the
// corners below 1.5 x the centre spot.
// ---------------------------------------------------------------------------

const float FWHM_TO_SIGMA = 0.4246609;   // Gaussian: sigma = FWHM / (2 sqrt(2 ln 2))

bool isPC(float scan) { return scan > 0.5 && scan < 1.5; }

// the tube is described in mm
bool inMM(float scan) { return isPC(scan) || (scan < 0.5 && LR_MON_MM > 0.5); }

// Viewable tube face in mm: one inch less than the nominal size, 4:3
vec2 monTubeMM()
{
    float d = (LR_MON_SIZE - 1.0) * 25.4;
    return vec2(0.8 * d, 0.6 * d);
}

// The full scan (active line x active lines) in mm: smaller than the tube face when
// overscan is negative (black border), larger when it is positive
vec2 monScanMM() { return monTubeMM() / (1.0 - LR_OVERSCAN); }

// The spot grows toward the corners (deflection defocus); c is the position on the tube, -1..1
float monCornerGrowth(vec2 c) { return 1.0 + (LR_MON_CORNER - 1.0) * 0.5 * dot(c, c); }

// Share of the active line that the source covers. A 15 kHz monitor in mm shows the whole
// active line (52.6 us NTSC, 52 us PAL), so a 320-pixel Amiga line (45 us) leaves side
// borders, like the real 1084S. PC monitors and the TV model fill the width.
float activeShare(Timing t, vec2 orig)
{
    if (!(t.scan < 0.5 && LR_MON_MM > 0.5)) return 1.0;
    return min(orig.x / t.pclk / (t.pal > 0.5 ? 52.0 : 52.6), 1.0);
}

// Standard normal density and cumulative distribution
// (erf after Abramowitz & Stegun 7.1.26, error below 1.5e-7)
vec3 gaussPdf(vec3 z) { return 0.39894228 * exp(-0.5 * z * z); }
vec3 gaussCdf(vec3 z)
{
    vec3 x = abs(z) * 0.70710678;
    vec3 t = 1.0 / (1.0 + 0.3275911 * x);
    vec3 p = ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t;
    return 0.5 + 0.5 * sign(z) * (1.0 - p * exp(-x * x));
}

// ---------------------------------------------------------------------------
// Colour of the TV: its chroma decoder and its phosphors
// ---------------------------------------------------------------------------

// Chroma decoder: 1 = by the standard. American and Japanese TVs demodulated R-Y and G-Y
// on shifted axes with their own gains ("red push", warmer skin tones). PAL TVs, broadcast
// monitors and RGB inputs use the standard axes.
float decoderType(Timing t, float cable)
{
    if (LR_DEMOD > 0.5) return LR_DEMOD;
    return (t.pal < 0.5 && cable < 2.5) ? 2.0 : 1.0;
}

// R, G, B from Y and the demodulated U, V (U = 0.492 (B-Y), V = 0.877 (R-Y)).
// Consumer axes and gains from the Sony CXA2025AS datasheet, relative to B-Y:
// US mode R-Y 112 deg x0.83, G-Y 252 deg x0.30; Japanese mode R-Y 95 deg x0.78, G-Y 240 deg x0.30.
vec3 decodeRGB(float Y, vec2 uv, float dec)
{
    if (dec < 1.5)
        return vec3(Y + 1.13983 * uv.y, Y - 0.39465 * uv.x - 0.58060 * uv.y, Y + 2.03211 * uv.x);
    bool us = dec < 2.5;
    float ar = radians(us ? 112.0 : 95.0), gr = us ? 0.83 : 0.78;
    float ag = radians(us ? 252.0 : 240.0), gg = 0.30;
    float ry = (uv.x * cos(ar) + uv.y * sin(ar)) * gr / 0.492;
    float gy = (uv.x * cos(ag) + uv.y * sin(ag)) * gg / 0.492;
    return vec3(Y + ry, Y + gy, Y + uv.x / 0.492);
}

// Phosphors: 1 sRGB / Rec.709, 2 SMPTE-C (NTSC sets), 3 EBU (PAL sets, broadcast monitors),
// 4 Japanese P22 (Sony Trinitron and Japanese sets, arcade monitors).
float phosphorSet(Timing t)
{
    if (LR_PHOS > 0.5) return LR_PHOS;
    if (t.scan > 0.5 && t.scan < 1.5) return 1.0;   // PC monitors: sRGB was defined from them
    if (t.id > 7.5) return 4.0;                       // arcade monitors
    return t.pal > 0.5 ? 3.0 : 2.0;
}

// Linear phosphor RGB -> linear Rec.709 RGB, white (D65) kept. Primaries (x, y):
// SMPTE-C R .630 .340 G .310 .595 B .155 .070; EBU R .640 .330 G .290 .600 B .150 .060;
// Japanese P22 R .625 .350 G .280 .605 B .152 .062 (Sony KV-20M20 and others, via Dogway's grade).
mat3 phosphorMatrix(float p)
{
    if (p < 2.5) return mat3(0.939542, 0.017772, -0.001622, 0.050181, 0.965793, -0.004370, 0.010277, 0.016435, 1.005991);
    if (p < 3.5) return mat3(1.044043, 0.0, 0.0, -0.044043, 1.0, 0.011793, 0.0, 0.0, 0.988207);
    return mat3(1.081942, 0.038032, -0.007481, -0.088427, 0.959991, 0.015170, 0.006485, 0.001977, 0.992311);
}

#if defined(VERTEX)
uniform mat4 MVPMatrix;
in vec4 VertexCoord;
in vec2 TexCoord;
out vec2 vTexCoord;

void lr_main()
{
    gl_Position = MVPMatrix * VertexCoord;
    vTexCoord = TexCoord;
}

flat out vec4 lrParams[2];

void main()
{
    // the adjustable values: blue channel of the first pass's first row
    LR_NORM = texelFetch(LR_Signal, ivec2(0, 0), 0).b;
    LR_DBLEND = texelFetch(LR_Signal, ivec2(1, 0), 0).b;
    LR_SAT = texelFetch(LR_Signal, ivec2(2, 0), 0).b;
    LR_BRIGHT = texelFetch(LR_Signal, ivec2(3, 0), 0).b;
    LR_CONTRAST = texelFetch(LR_Signal, ivec2(4, 0), 0).b;
    LR_STEADY = texelFetch(LR_Signal, ivec2(5, 0), 0).b;
    lrParams[0] = vec4(LR_NORM, LR_DBLEND, LR_SAT, LR_BRIGHT);
    lrParams[1] = vec4(LR_CONTRAST, LR_STEADY, 0.0, 0.0);
    lr_main();
}

#elif defined(FRAGMENT)
in vec2 vTexCoord;
out vec4 FragColor;
uniform sampler2D Source;    // encoded signal
uniform sampler2D Original;  // used directly for RGB

vec2 sig(float s, float y)
{
    if (y < 0.0) return vec2(0.0);
    return textureLod(Source, vec2((s + 0.5) * LR_SourceSize.z, (y + 0.5) * LR_SourceSize.w), 0.0).rg;
}

// Original pixel at x position xs on the native line that starts at row y (k rows averaged)
vec3 origPix(float xs, float y, float k)
{
    if (xs < 0.0 || xs >= LR_OriginalSize.x) return vec3(0.0);
    float u = (floor(xs) + 0.5) * LR_OriginalSize.z;
    vec3 c = vec3(0.0);
    for (float r = 0.0; r < k; r += 1.0)
        c += textureLod(Original, vec2(u, (y + r + 0.5) * LR_OriginalSize.w), 0.0).rgb;
    return c / k;
}

// Rotate a (cos, sin) pair by the angle whose (cos, sin) is r
vec2 rotate(vec2 e, vec2 r) { return vec2(e.x * r.x - e.y * r.y, e.y * r.x + e.x * r.y); }

void lr_main()
{
    Timing T = getTiming(LR_OriginalSize.xy, LR_FrameCount);
    float SW = LR_SourceSize.x;
    float fs = T.pclk * SW / LR_OriginalSize.x;
    float n = floor(vTexCoord.x * SW);
    float y = floor(vTexCoord.y * LR_SourceSize.y);
    float st = (T.interlace > 0.5 ? 2.0 : 1.0) * T.scale;   // previous line of the same field
    float cable = LR_CABLE;
    float Y;
    vec2 uv;

    // upscaled frame: only the first row of each native line is decoded
    if (mod(y, T.scale) > 0.5)
    {
        FragColor = vec4(0.0);
        return;
    }

    if (cable > 2.5)
    {
        // RGB: no NTSC/PAL at all, only the video amplifier bandwidth: ~6.5 MHz in a TV,
        // ~85 MHz in a 15-inch PC monitor (spec sheets of the 90s: 65-120 MHz)
        float xs = (n + 0.5) * T.pclk / fs;
        float sigPx = 0.1325 / (isPC(T.scan) ? 85.0 : 6.5) * T.pclk;

        // dither blend: the 1-pixel alternating part around the five console pixels
        // the amplifier taps can reach, taken out of every tap below
        float db = LR_DBLEND;
        float sp = T.scale;
        float j0 = floor(xs / sp);
        vec3 alt[5];
        for (int i = 0; i < 5; i++) alt[i] = vec3(0.0);
        if (db > 0.0)
        {
            vec3 p[13];
            for (int i = 0; i < 13; i++) p[i] = origPix((j0 + float(i - 6) + 0.5) * sp, y, T.scale);
            for (int i = 0; i < 5; i++)
            {
                vec3 a = vec3(0.0);
                for (int k = -4; k <= 4; k++) a += DBW[abs(k)] * dbSign(k) * (p[i + 4 + k] - p[i + 4]);
                alt[i] = db * a / DBN;
            }
        }

        vec3 acc = vec3(0.0);
        float ws = 0.0;
        for (int k = -3; k <= 3; k++)
        {
            float w = exp(-0.5 * float(k * k));
            float xt = xs + float(k) * sigPx;
            vec3 v = origPix(xt, y, T.scale);
            if (db > 0.0) v -= alt[clamp(int(floor(xt / sp) - j0) + 2, 0, 4)];
            acc += w * v;
            ws += w;
        }
        vec3 c = acc / ws;
        Y = dot(c, vec3(0.299, 0.587, 0.114));
        uv = vec2(0.492 * (c.b - Y), 0.877 * (c.r - Y));
    }
    else
    {
        bool pal = T.pal > 0.5;
        bool sv = cable > 1.5;
        bool comb = LR_COMB > 0.5 && !sv && !pal && cable > 0.5 && abs(T.lineFrac - 0.5) < 0.05;

        float fcY, fcC, notch;
        if (cable < 0.5)  { fcY = pal ? 3.6 : 2.8; notch = 0.95; fcC = 0.5; }
        else if (!sv)     { fcY = comb ? 4.2 : (pal ? 4.2 : 3.3); notch = comb ? 0.0 : 0.92; fcC = pal ? 0.8 : 0.6; }
        else              { fcY = pal ? 5.0 : 4.6; notch = 0.0; fcC = pal ? 1.0 : 0.9; }

        float tn = n / fs;
        float sh = LR_SHARP * 1.4;

        // All taps sit on whole samples. A tap between two samples would read a linear
        // blend of them, and that blend loses part of the subcarrier (colour came out
        // up to 9% weaker). The tap step is a whole number of samples, so the subcarrier
        // still advances by the same angle from tap to tap.

        // luma: (1 + sh) * G(s1) - sh * G(s2), unit gain at DC, boost in the middle.
        float s1 = 0.1325 / fcY;
        float s2 = s1 * 2.5;
        float mY = max(1.0, ceil(0.25 * s2 * fs)); // tap step in samples (at most s2 / 4)
        float nY = min(ceil(3.0 * s2 * fs / mY), 12.0);
        float c1 = -0.5 * mY * mY / (s1 * s1 * fs * fs);
        float c2 = -0.5 * mY * mY / (s2 * s2 * fs * fs);
        float a1 = 0.0, a2 = 0.0, w1s = 0.0, w2s = 0.0;
        int nYi = int(nY);
        for (int k = -nYi; k <= nYi; k++)
        {
            float u = float(k);
            float w1 = exp(c1 * u * u);
            float w2 = exp(c2 * u * u);
            float sp = n + u * mY;
            float s0 = sig(sp, y).x;
            if (comb) s0 = 0.5 * (s0 + sig(sp, y - st).x);
            a1 += w1 * s0; a2 += w2 * s0; w1s += w1; w2s += w2;
        }
        Y = (1.0 + sh) * a1 / w1s - sh * a2 / w2s;

        // chroma: demodulate against the subcarrier, then low-pass.
        // The subcarrier's (cos, sin) is rotated from tap to tap instead of recomputed.
        float sc = 0.1325 / fcC;
        float mC = max(1.0, ceil(0.15 * sc * fs)); // tap step in samples (at most 0.15 sigma)
        float nC = min(ceil(3.0 * sc * fs / mC), 20.0);
        float cw = -0.5 * mC * mC / (sc * sc * fs * fs);
        float vs = vSign(y, T), vsp = vSign(y - st, T);
        float tint = pal ? 0.0 : radians(LR_TINT);
        if (cable < 0.5)
        {
            // RF: the echo is on the colour burst too, so the TV locks to the shifted phase
            float ea = -TAU * T.fsc * RF_ECHO_US;
            tint += atan(RF_ECHO * sin(ea), 1.0 + RF_ECHO * cos(ea));
        }
        float ph0 = phaseAt(tn, y, T) + tint;      // subcarrier phase at the centre tap
        float da = TAU * T.fsc * mC / fs;
        vec2 rp = vec2(cos(da), sin(da));
        vec2 e0 = vec2(cos(ph0), sin(ph0));
        float a0 = ph0 - nC * da;
        a0 -= TAU * floor(a0 / TAU + 0.5);         // keep the angle small for an accurate sin/cos
        vec2 e = vec2(cos(a0), sin(a0));           // (cos, sin) at the first tap
        vec2 acc = vec2(0.0), accp = vec2(0.0);    // sums of w * signal * (sin, cos)
        float wcs = 0.0;
        int nCi = int(nC);
        for (int k = -nCi; k <= nCi; k++)
        {
            float u = float(k);
            float w = exp(cw * u * u);
            float sp = n + u * mC;
            vec2 v0 = sig(sp, y);
            float s0 = sv ? v0.y : v0.x;
            if (comb) s0 = 0.5 * (v0.x - sig(sp, y - st).x);
            acc += w * s0 * e.yx;
            if (pal)
            {
                vec2 vp = sig(sp, y - st);
                accp += w * (sv ? vp.y : vp.x) * e.yx;
            }
            wcs += w;
            e = rotate(e, rp);
        }
        vec2 cs = 2.0 * vec2(acc.x, vs * acc.y);
        uv = cs / wcs;

        if (!sv && !comb && notch > 0.0)
        {
            // trap: take the chroma band back out of luma
            float hf = (1.0 + sh) * exp(-19.7392 * s1 * s1 * T.fsc * T.fsc) - sh * exp(-19.7392 * s2 * s2 * T.fsc * T.fsc);
            Y -= notch * hf * (uv.x * e0.y + vs * uv.y * e0.x);
        }
        if (pal)
        {
            // the previous line has its own subcarrier phase: rotate its sums by the difference
            float dl = phaseAt(tn, y - st, T) - (ph0 - tint);
            vec2 rd = vec2(cos(dl), sin(dl));
            vec2 csp = 2.0 * vec2(accp.x * rd.x + accp.y * rd.y, vsp * (accp.y * rd.x - accp.x * rd.y));
            uv = 0.5 * (uv + csp / wcs);
        }
        if (cable < 0.5)
        {
            // RF: the echo also lands on sync and burst, and the TV's automatic gain and
            // colour control scale the picture back, so flat areas keep their level and colour
            float ea = -TAU * T.fsc * RF_ECHO_US;
            Y /= 1.0 + RF_ECHO;
            uv /= length(vec2(1.0 + RF_ECHO * cos(ea), RF_ECHO * sin(ea)));
        }
    }

    uv *= LR_SAT * LR_CONTRAST;
    Y = Y * LR_CONTRAST + LR_BRIGHT;
    vec3 rgb = decodeRGB(Y, uv, decoderType(T, cable));
    FragColor = vec4(clamp(rgb, 0.0, 1.0), 1.0);
}

flat in vec4 lrParams[2];

void main()
{
    LR_NORM = lrParams[0].x;
    LR_DBLEND = lrParams[0].y;
    LR_SAT = lrParams[0].z;
    LR_BRIGHT = lrParams[0].w;
    LR_CONTRAST = lrParams[1].x;
    LR_STEADY = lrParams[1].y;
    lr_main();
}
#endif
